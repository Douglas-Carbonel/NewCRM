{
  "name": "crm-platform",
  "version": "1.0.0",
  "description": "CRM moderno integrado ao SAP Business One",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:sap": "pnpm --filter sap-integration dev",
    "dev:strapi": "pnpm --filter strapi-crm dev",
    "dev:frontend": "pnpm --filter crm-frontend dev",
    "build": "pnpm -r build",
    "install:all": "pnpm install"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "core-js-pure",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
