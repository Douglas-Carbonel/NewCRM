modules = ["nodejs-20"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start SAP Integration"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter crm-frontend dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start SAP Integration"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter sap-integration dev"
waitForPort = 3000

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 5000

[deployment]
deploymentTarget = "autoscale"
run = ["pnpm", "--filter", "crm-frontend", "start"]
build = ["pnpm", "--filter", "crm-frontend", "build"]

[userenv]

[userenv.shared]
SAP_URL = "https://177.8.39.34:50000/b1s/v1"
SAP_COMPANY = "SBODEMOBR_DEV"
SAP_TIMEOUT_MS = "15000"
SAP_SERVICE_URL = "http://localhost:3000"
